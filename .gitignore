# ============================================================
# Meeting Organizer Agent - .gitignore
# FastAPI + LangGraph backend, worker, React/Vite frontend
# ============================================================

# ----- Secrets and environment files -----
.env
.env.*
!.env.example
*.env
!*.env.example

# ----- Google OAuth credentials and tokens -----
client_secret*.json
client_secrets.json
credentials.json
token.json
token.pickle
*token*.json
service-account*.json
*-service-account*.json
*.pem
*.key
*.p12
*.pfx

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg
.eggs/
.installed.cfg
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
venv/
.venv/
env/
ENV/

# Python build output (anchored so source folders with these names are not ignored)
/build/
/dist/
/backend/build/
/backend/dist/
wheels/

# ----- Test / coverage artifacts -----
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/
tests/.test_meeting_organizer.db
tests/.test_meeting_organizer.db-*

# ----- Node / Frontend (React + Vite) -----
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
*.tsbuildinfo

# ----- Local databases and backups -----
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sql.gz
*.dump
database/backups/
*_backup.*
meeting_organizer_backup.*

# ----- Browser-recorded meeting audio (never commit) -----
data/recordings/
*.webm
*.wav

# ----- Logs and temporary files -----
*.log
logs/
*.tmp
*.temp
*.bak
*.orig
*.rej
tmp/
temp/

# ----- IDE / editor -----
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-workspace
*.code-workspace

# ----- OS -----
.DS_Store
Thumbs.db
desktop.ini

# ----- Claude Code local settings -----
.claude/settings.local.json
