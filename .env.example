# ============================================================
# MEETING ORGANIZER AGENT — Environment Variables
# Copy this file to .env (in the project root, where uvicorn is started) and fill in your values.
# NEVER commit .env with real credentials to version control.
#
# Google credentials are configuration only. Today: your Google Cloud TEST OAuth client.
# Later: the organization's production OAuth client. Only the values below change —
# agents, LangGraph workflow, MCP, RAG, tools and persistence stay the same.
# ============================================================

# ----- AI PROVIDER (Groq) -----
# Used for natural-language extraction, agenda refinement, minutes generation and audio transcription.
# Without a key, extraction/agenda fall back to the built-in rule-based parser; minutes and transcription report a clear error.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_LLM_MODEL=openai/gpt-oss-120b
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3

# ----- MODE -----
# false (default): the live application uses real Google Calendar, Google Meet and Gmail.
# true: offline test adapters (no real events, simulated IDs/links) — for tests/offline development only.
DEMO_MODE=false

# Time zone used to interpret times typed in requests ("10 AM"). Stored times are UTC.
MEETING_TIMEZONE=UTC

# ----- DATABASE -----
# Standardized on PostgreSQL (psycopg3 driver)
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg://postgres:1234@localhost:5432/meeting_organizer

# ----- GOOGLE OAUTH 2.0 (PKCE) -----
# Create a "Web application" OAuth client at https://console.cloud.google.com/apis/credentials
# Enable: Google Calendar API, Gmail API. While the consent screen is in "Testing", add every
# employee's Google account as a test user. The redirect URI below must be registered exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
GOOGLE_CLOUD_PROJECT_ID=
# Space- or comma-separated. Defaults to: openid, userinfo.email, calendar, gmail.send, gmail.readonly
GOOGLE_OAUTH_SCOPES=openid https://www.googleapis.com/auth/userinfo.email https://www.googleapis.com/auth/calendar https://www.googleapis.com/auth/gmail.send https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/meetings.space.readonly
# Optional overrides (defaults are Google's public endpoints)
# GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
# GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
# Seconds an OAuth state/PKCE verifier stays valid (single use)
GOOGLE_OAUTH_STATE_TTL_SECONDS=600
# Optional: restrict sign-in to one Google Workspace domain, e.g. yourcompany.com
GOOGLE_HOSTED_DOMAIN=

# Optional: registered + connected employee whose Google account organizes events and sends mail.
# If empty: the first connected participant is used, then any connected employee.

# ----- MINUTES OF MEETING (Google Meet transcripts) -----
# The worker keeps retrying for a transcript this long after a meeting ends.
MINUTES_MAX_WAIT_HOURS=48
# Optional: shared secret for a Pub/Sub push subscription (Workspace Events) posting to /api/meet/events?token=...
MEET_EVENTS_TOKEN=

# ----- BROWSER-RECORDED MEETING AUDIO (alternative when Google provides no transcript, e.g. personal Gmail) -----
# Raw audio is stored on disk (never in PostgreSQL). The API and the worker must see the same folder.
RECORDINGS_DIR=data/recordings
# Raw audio is deleted this many days after a successful transcription (0 = immediately). Transcripts are kept.
RECORDING_RETENTION_DAYS=7
RECORDING_MAX_SEGMENT_MB=24
# Speech-to-text uses GROQ_API_KEY and GROQ_TRANSCRIPTION_MODEL (same key as the minutes generator).
TRANSCRIPTION_MAX_ATTEMPTS=5

# ----- RUNTIME GOVERNANCE (budgets for one scheduling or minutes run) -----
# Workflow nodes per run (also LangGraph's recursion limit), LLM requests per run, and wall-clock seconds per run.
RUNTIME_MAX_STEPS=50
RUNTIME_MAX_LLM_CALLS=20
RUNTIME_MAX_SECONDS=300
# The worker resumes an approved meeting that has been stuck in EXECUTING (crashed run) for this many minutes.
EXECUTION_STUCK_MINUTES=10

# ----- AUDITORIUM / FACILITY BOOKING -----
# There is no facility booking API: requests are emailed here (via Gmail) and the meeting waits for a reply.
# Optional: JSON list of rooms [{"name","capacity","equipment","location","requires_approval"}]
# ROOM_CATALOG_FILE=./rooms.json

GOOGLE_CALENDAR_OWNER_EMAIL=karenpinheiro2415@gmail.com
# ----- SECURITY -----
# Required for signing OAuth state tokens. Use a long random string.
# Example generation: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ----- SERVER / FRONTEND -----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# The single unified frontend (Employees + Meeting Organizer). OAuth returns here.
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
