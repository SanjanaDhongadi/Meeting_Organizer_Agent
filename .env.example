# ============================================================
# MEETING ORGANIZER AGENT — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env with real credentials to version control.
# ============================================================

# ----- LLM -----
# OpenAI API key for natural language extraction and meeting planning.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ----- MODE -----
# Set DEMO_MODE=true to run without real Google/Calendar/Email credentials
# (uses mock services for offline testing).
# Set DEMO_MODE=false to use real Google Calendar, Gmail, and Google Meet APIs.
DEMO_MODE=true

# ----- DATABASE -----
# Default: local SQLite (no setup required).
# For PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/meeting_organizer
DATABASE_URL=sqlite:///./meeting_organizer.db

# ----- GOOGLE OAUTH 2.0 -----
# Required when DEMO_MODE=false.
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must be registered in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
GOOGLE_CLOUD_PROJECT_ID=

# Optional: default Google account used for creating Calendar events (organizer's email).
GOOGLE_CALENDAR_OWNER_EMAIL=

# ----- AUDITORIUM / FACILITY BOOKING -----
# Email address of the person who receives and approves offline/auditorium booking requests.
# This is NOT hardcoded — it is read from this environment variable at runtime.
AUDITORIUM_BOOKING_EMAIL=auditorium.booking@yourcompany.com

# ----- SECURITY -----
# Required for signing OAuth state tokens. Use a long random string in production.
# Example generation: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ----- SERVER -----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ----- FRONTEND PORTS (for reference) -----
# Employee Dashboard runs on:  http://localhost:5173  (npm run dev:employee)
# Meeting Organizer runs on:   http://localhost:5174  (npm run dev:meeting)
FRONTEND_EMPLOYEE_PORT=5173
FRONTEND_MEETING_PORT=5174