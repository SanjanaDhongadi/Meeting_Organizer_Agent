# ============================================================
# MEETING ORGANIZER AGENT — Environment Variables
# Copy this file to .env (in the project root, where uvicorn is started) and fill in your values.
# NEVER commit .env with real credentials to version control.
#
# Google credentials are configuration only. Today: your Google Cloud TEST OAuth client.
# Later: the organization's production OAuth client. Only the values below change —
# agents, LangGraph workflow, MCP, RAG, tools and persistence stay the same.
# ============================================================

# ----- LLM -----
# Optional. Used for natural-language extraction and agenda drafting (regex/template fallback otherwise).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ----- MODE -----
# false (default): the live application uses real Google Calendar, Google Meet and Gmail.
# true: offline test adapters (no real events, simulated IDs/links) — for tests/offline development only.
DEMO_MODE=false

# Time zone used to interpret times typed in requests ("10 AM"). Stored times are UTC.
MEETING_TIMEZONE=UTC

# ----- DATABASE -----
# Default: local SQLite (no setup required).
# For PostgreSQL: postgresql+psycopg://user:password@localhost:5432/meeting_organizer
DATABASE_URL=sqlite:///./meeting_organizer.db

# ----- GOOGLE OAUTH 2.0 (PKCE) -----
# Create a "Web application" OAuth client at https://console.cloud.google.com/apis/credentials
# Enable: Google Calendar API, Gmail API. While the consent screen is in "Testing", add every
# employee's Google account as a test user. The redirect URI below must be registered exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
GOOGLE_CLOUD_PROJECT_ID=
# Space- or comma-separated. Defaults to: openid, userinfo.email, calendar, gmail.send, gmail.readonly
GOOGLE_OAUTH_SCOPES=openid https://www.googleapis.com/auth/userinfo.email https://www.googleapis.com/auth/calendar https://www.googleapis.com/auth/gmail.send https://www.googleapis.com/auth/gmail.readonly
# Optional overrides (defaults are Google's public endpoints)
# GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
# GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
# Seconds an OAuth state/PKCE verifier stays valid (single use)
GOOGLE_OAUTH_STATE_TTL_SECONDS=600
# Optional: restrict sign-in to one Google Workspace domain, e.g. yourcompany.com
GOOGLE_HOSTED_DOMAIN=

# Optional: registered + connected employee whose Google account organizes events and sends mail.
# If empty: the first connected participant is used, then any connected employee.
GOOGLE_CALENDAR_OWNER_EMAIL=

# ----- AUDITORIUM / FACILITY BOOKING -----
# There is no facility booking API: requests are emailed here (via Gmail) and the meeting waits for a reply.
AUDITORIUM_BOOKING_EMAIL=auditorium.booking@yourcompany.com
# Optional: JSON list of rooms [{"name","capacity","equipment","location","requires_approval"}]
# ROOM_CATALOG_FILE=./rooms.json

# ----- SECURITY -----
# Required for signing OAuth state tokens. Use a long random string.
# Example generation: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ----- SERVER / FRONTEND -----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# The single unified frontend (Employees + Meeting Organizer). OAuth returns here.
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
